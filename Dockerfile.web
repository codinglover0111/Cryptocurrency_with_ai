FROM ghcr.io/astral-sh/uv:python3.12-alpine

WORKDIR /app

# uv Alpine 파생 이미지에서는 apk를 사용해 빌드 의존성을 설치한다.
RUN apk add --no-cache \
    pkgconf \
    python3-dev \
    mariadb-dev \
    build-base \
    curl \
    tzdata

# 시스템 파이썬에 직접 설치하도록 uv 기본값을 고정한다.
ENV UV_SYSTEM_PYTHON=1 \
    TZ=Asia/Seoul \
    PYTHONUNBUFFERED=1

# 의존성 파일만 먼저 복사해 레이어 캐시를 극대화한다.
COPY requirements.txt .
RUN uv pip install --system -r requirements.txt

# 전체 프로젝트 복사
COPY . .

CMD ["uv", "run", "uvicorn", "webapp:app", "--host", "0.0.0.0", "--port", "8000"]