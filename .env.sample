BYBIT_API_KEY=...
BYBIT_API_SECRET=...
BYBIT_ENV=demo               # demo | testnet | mainnet

GEMINI_API_KEY=...
OPENAI_API_KEY=...
OPENROUTER_API_KEY=...

TRADING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MAX_ALLOC_PERCENT=20
DEFAULT_LEVERAGE=5
MAX_LOSS_PERCENT=80

SQLITE_PATH=data/trading.sqlite
# MYSQL_URL=mysql+pymysql://user:pass@host:3306/db

API_KEY_ENCRYPTION_KEY=

# Supabase 인증 (Next.js + FastAPI)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_JWKS_URL를 지정하지 않으면 위 URL 기준 /auth/v1/jwks를 사용합니다.
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/jwks

# Bot 실행 모드
# - runner: Supabase Queues(PGMQ) 소비자만 실행
# - scheduler: 스케줄러만 실행(기본 로직)
# - both: scheduler + runner 동시 실행(권장)
BOT_MODE=both

# 레거시 실행(롤백 플랜)
# - 1: 기존처럼 로컬 스레드에서 즉시 실행(큐 미사용)
# - 0: 큐 기반 실행(enqueue/consume)
USE_LEGACY_EXECUTION=0

# 스케줄러 설정
# - 런타임 설정 변경 감지 주기(초)
SCHEDULER_REFRESH_SECONDS=30
# - 시작 시 즉시 1회 실행 여부(1이면 시작하자마자 job/review 실행)
COLD_START=0

# CORS(운영 환경에 맞게 설정)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# CORS_ALLOWED_ORIGIN_REGEX=https://.*\.up\.railway\.app
